# Copie para backend/.env e preencha (o .env NÃO vai para o git)
# Banco Postgres (Neon > Connect, com "Connection pooling" DESLIGADO). Formato JDBC:
DB_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USER=neondb_owner
DB_PASSWORD=

# Segredo para assinar os tokens JWT (openssl rand -base64 48)
APP_JWT_SECRET=

APP_CORS_ORIGINS=http://localhost:5173

# Academia desta instalação (cada academia tem o seu back-end e o seu banco)
APP_ACADEMIA_NOME=Academia Exemplo
# Administrador criado na primeira subida (para outra academia, troque nome e e-mail)
APP_ADMIN_NOME=Administrador
APP_ADMIN_EMAIL=admin@exemplo.com
# Senha do administrador (definida aqui, nunca no código)
APP_ADMIN_PASSWORD=

# Portal do aluno: senha inicial de todos os alunos (login = CPF). Padrão: 123456
# APP_ALUNO_SENHA_PADRAO=123456

# Asaas (aba Cobranças). Chave em Asaas > Integrações > Chave de API.
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token livre (ex.: openssl rand -hex 24) cadastrado também no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=
